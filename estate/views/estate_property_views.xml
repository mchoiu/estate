<?xml version="1.0"?>
<odoo>
    <!-- Action -->
    <record id='estate.property_action' model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_availability_filter': True}</field>
    </record>


    <!-- Kanban View -->
    <record id="estate.property_view_kanban" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban records_draggable="0" default_group_by="property_type">
                <templates>
                    <t t-name="card">
                        <div>
                            <h1>
                                <strong>
                                    <field name="title"/>
                                </strong>
                            </h1>
                        </div>
                        <div>
                            <h1>
                                <field name="tag_ids" mode="kanban"/>
                            </h1>
                        </div>
                        <div>
                            <strong>Expected Price:</strong>
                            <field name="expected_price"/>
                        </div>
                        <div t-if="record.best_price.raw_value > 0.0">
                            <strong>Best Offer:</strong>
                            <field name="best_price"/>
                        </div>
                        <div t-if="record.selling_price.raw_value > 0.0">
                            <strong>Selling Price:</strong>
                            <field name="selling_price"/>
                        </div>

                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List View -->
    <record id="estate.property_view_tree" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Properties"
                  decoration-muted="state == 'sold'"
                  decoration-danger="state == 'canceled'"
                  decoration-bf="state == 'offer_accepted'"
                  decoration-success="state in ['offer_accepted', 'offer_received']"
            >
                <field name="title"/>
                <field name="postcode"/>
                <field name="tag_ids" widget="many2many_tags"
                       options="{'color_field': 'color','no_create': True, 'no_edit': True}"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability" optional='1'/>
            </list>
        </field>
    </record>


    <!-- Form View -->
    <record id="estate.property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Properties">
                <header>
                    <group invisible="state == 'sold' or state == 'canceled'">
                        <button string="Sold"
                                type="object"
                                name="action_set_property_as_sold"
                                class="btn btn-success"/>
                        <button string="Cancel"
                                type="object"
                                name="action_set_property_as_canceled"
                                class="btn btn-danger"
                                invisible=""
                        />
                    </group>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new, offer_received, offer_accepted, sold"/>
                </header>
                <sheet>
                    <!-- Top section with key info -->
                    <div style="font-size:36px; font-weight:bold; margin-bottom: 20px;">
                        <field name="title"/>
                    </div>
                    <group>
                        <group>
                            <field name="state"/>
                            <field name="property_type" options="{'no_create': True, 'no_edit': True}"/>
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color','no_create': True, 'no_edit': True}"/>
                            <field name="postcode"/>
                            <field name="date_availability" string="Available From"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="best_price"/>
                            <field name="selling_price"/>
                        </group>
                    </group>

                    <!-- Tabbed section -->
                    <notebook>
                        <page string="Description">
                            <group>
                                <group>
                                    <field name="description"/>
                                    <field name="bedrooms"/>
                                    <field name="living_area" string="Living Area (sqm)"/>
                                    <field name="facades"/>
                                    <field name="garage"/>
                                    <field name="garden"/>
                                    <field name="garden_area" string="Garden Area (sqm)" invisible="not garden"/>
                                    <field name="garden_orientation" string="Garden Orientation"
                                           invisible="not garden"/>
                                    <field name="total_area" string="Total Area (sqm)"/>
                                </group>
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids" readonly="state in ['sold', 'offer_accepted', 'canceled'] "/>
                        </page>
                        <page string="Othe4r Info">
                            <group>
                                <group>
                                    <field name="sales_person"/>
                                    <field name="buyer" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="estate.property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <!-- Search Field-->
                <field name="title"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area" filter_domain="[('living_area', '>=', self)]"/>
                <field name="facades"/>

                <!-- Filter Field-->
                <filter name="availability_filter" string="Availability"
                        domain="['|', ('state','=','new'), ('state','=','offer_received')]"/>
                <!--Group By-->
                <group>
                    <filter name="postcode_groupby" context="{'group_by':'postcode'}" string="Postcode"/>
                </group>
            </search>
        </field>
    </record>


</odoo>
